# DeployStack — AWS Aurora PostgreSQL (your cluster)
# Copy to .env on EC2 and replace YOUR_RDS_PASSWORD only:
#   cp .env.rds.example .env
#   nano .env

PLATFORM_DOMAIN=your-domain.com
PLATFORM_NAME=DeployStack
SECRET_KEY=generate-a-long-random-string-min-32-chars
ENCRYPTION_KEY=generate-another-long-random-string-min-32-chars

# Aurora Writer endpoint (NOT the -ro- reader)
RDS_HOST=database-1.cluster-covwo0uikrnc.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_USER=postgres
RDS_PASSWORD=YOUR_RDS_PASSWORD
RDS_DB=postgres

DATABASE_URL=postgresql+asyncpg://postgres:YOUR_RDS_PASSWORD@database-1.cluster-covwo0uikrnc.us-east-1.rds.amazonaws.com:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:YOUR_RDS_PASSWORD@database-1.cluster-covwo0uikrnc.us-east-1.rds.amazonaws.com:5432/postgres

# If connection fails, try adding SSL (uncomment one line below and remove lines above):
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_RDS_PASSWORD@database-1.cluster-covwo0uikrnc.us-east-1.rds.amazonaws.com:5432/postgres?ssl=require
# DATABASE_URL_SYNC=postgresql://postgres:YOUR_RDS_PASSWORD@database-1.cluster-covwo0uikrnc.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require

REDIS_URL=redis://redis:6379/0

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://your-domain.com/auth/callback
GITHUB_WEBHOOK_SECRET=

API_URL=https://api.your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com
NEXT_PUBLIC_PLATFORM_DOMAIN=your-domain.com

ADMIN_EMAIL=your-email@example.com

TRAEFIK_NETWORK=traefik-public
AWS_S3_REGION=us-east-1
USE_S3_ARTIFACTS=false
