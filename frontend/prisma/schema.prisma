generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  role      String   @default("user")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  githubAccount GitHubAccount?
  projects      Project[]

  @@map("users")
}

model GitHubAccount {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  githubId       String   @unique @map("github_id")
  githubUsername String   @map("github_username")
  accessToken    String   @map("access_token_encrypted")
  scopes         String?
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_accounts")
}

model Project {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  name               String
  slug               String   @unique
  githubRepoFullName String   @map("github_repo_full_name")
  defaultBranch      String   @default("main") @map("default_branch")
  framework          String?
  rootDirectory      String   @default(".") @map("root_directory")
  buildCommand       String?  @map("build_command")
  installCommand     String?  @map("install_command")
  outputDirectory    String?  @map("output_directory")
  startCommand       String?  @map("start_command")
  deploymentType     String   @default("static") @map("deployment_type")
  status             String   @default("active")
  activeDeploymentId String?  @map("active_deployment_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments          Deployment[]
  domains              Domain[]
  environmentVariables EnvironmentVariable[]

  @@index([userId])
  @@map("projects")
}

model Deployment {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  version          Int
  branch           String
  commitSha        String?  @map("commit_sha")
  commitMessage    String?  @map("commit_message")
  status           String   @default("pending")
  buildStatus      String   @default("pending") @map("build_status")
  deploymentStatus String   @default("pending") @map("deployment_status")
  deploymentUrl    String?  @map("deployment_url")
  previewUrl       String?  @map("preview_url")
  errorMessage     String?  @map("error_message")
  triggeredBy      String   @default("manual") @map("triggered_by")
  buildDurationMs  Int?     @map("build_duration_ms")
  totalDurationMs  Int?     @map("total_duration_ms")
  isProduction     Boolean  @default(true) @map("is_production")
  isPreview        Boolean  @default(false) @map("is_preview")
  createdAt        DateTime @default(now()) @map("created_at")

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs    DeploymentLog[]

  @@index([projectId])
  @@map("deployments")
}

model DeploymentLog {
  id           String   @id @default(uuid())
  deploymentId String   @map("deployment_id")
  level        String   @default("info")
  message      String
  step         String?
  createdAt    DateTime @default(now()) @map("created_at")

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@map("deployment_logs")
}

model Domain {
  id                String   @id @default(uuid())
  projectId         String   @map("project_id")
  domain            String   @unique
  isVerified        Boolean  @default(false) @map("is_verified")
  sslStatus         String   @default("pending") @map("ssl_status")
  verificationToken String?  @map("verification_token")
  dnsRecords        Json?    @map("dns_records")
  createdAt         DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("domains")
}

model EnvironmentVariable {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  key         String
  value       String
  environment String   @default("production")
  isSecret    Boolean  @default(true) @map("is_secret")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key, environment])
  @@index([projectId])
  @@map("environment_variables")
}
