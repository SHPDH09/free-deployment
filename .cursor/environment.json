{
  "name": "DeployStack",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "install": "./.cursor/install.sh",
  "start": "./.cursor/start.sh",
  "ports": [
    { "name": "web", "port": 3000 },
    { "name": "api", "port": 8000 },
    { "name": "postgres", "port": 5432 },
    { "name": "redis", "port": 6379 }
  ],
  "terminals": [
    {
      "name": "api",
      "command": "bash -lc 'source /workspace/.venv/bin/activate && cd /workspace/backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000'",
      "description": "FastAPI backend on port 8000"
    },
    {
      "name": "worker",
      "command": "bash -lc 'source /workspace/.venv/bin/activate && cd /workspace/worker && python main.py'",
      "description": "Build worker (requires Docker socket)"
    },
    {
      "name": "web",
      "command": "bash -lc 'cd /workspace/frontend && npm run dev -- -H 0.0.0.0 -p 3000'",
      "description": "Next.js dashboard on port 3000"
    }
  ]
}
