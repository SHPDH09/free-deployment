# Platform Configuration
PLATFORM_DOMAIN=platform.localhost
PLATFORM_NAME=DeployStack
SECRET_KEY=change-me-to-a-long-random-string-in-production
ENCRYPTION_KEY=change-me-32-byte-base64-fernet-key

# Database (local Docker — use profile local-db)
# For AWS RDS / Aurora, set URLs below and do NOT use local-db profile
DATABASE_URL=postgresql+asyncpg://deploy:deploy@postgres:5432/deploystack
DATABASE_URL_SYNC=postgresql://deploy:deploy@postgres:5432/deploystack

# AWS Aurora example (replace USER, PASSWORD, DB_NAME):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@database-1.cluster-covwo0uikrnc.us-east-1.rds.amazonaws.com:5432/deploystack
# DATABASE_URL_SYNC=postgresql://USER:PASSWORD@database-1.cluster-covwo0uikrnc.us-east-1.rds.amazonaws.com:5432/deploystack

# Redis
REDIS_URL=redis://redis:6379/0

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/callback
GITHUB_WEBHOOK_SECRET=

# GitHub App (optional, for enhanced permissions)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Cloudflare (for DNS/SSL)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# AWS S3 (optional, for artifacts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
USE_S3_ARTIFACTS=false

# Traefik
TRAEFIK_NETWORK=deploystack

# Build limits
MAX_CONCURRENT_BUILDS=3
BUILD_TIMEOUT_SECONDS=600
MAX_BUILD_MEMORY_MB=2048
MAX_BUILD_CPU=2.0
MAX_DEPLOYMENT_SIZE_MB=500
MAX_PROJECTS_PER_USER=20
MAX_DEPLOYMENTS_PER_DAY=50

# Storage
ARTIFACTS_PATH=/data/artifacts
DEPLOYMENTS_PATH=/data/deployments
LOGS_PATH=/data/logs

# API
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PLATFORM_DOMAIN=platform.localhost

# Admin (initial admin email)
ADMIN_EMAIL=
